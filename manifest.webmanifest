{
  "name": "RunDeck",
  "short_name": "RunDeck",
  "description": "A gamified task deck: finish tasks, earn XP, level up.",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#070a13",
  "theme_color": "#070a13",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable"},
    {"src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "New task", "short_name": "New task", "url": "/?new=1", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Focus", "short_name": "Focus", "url": "/?view=focus", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]}
  ]
}
